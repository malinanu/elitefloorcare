# Server: ~/htdocs/<domain>/shared/.env  (chmod 600). Local dev: .env.local
# ── Site ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://elitesportsfloorcare.com.au   # build-time; set it in GitHub (staging env) too

# ── Payload CMS ────────────────────────────────────────────────────
PAYLOAD_SECRET=                      # openssl rand -hex 32  — never change it after launch (logs everyone out)
ADMIN_EMAIL=                         # first admin, created on first boot only
ADMIN_PASSWORD=                      # change it in /admin after first login
# DATABASE_URI=file:/home/<site-user>/htdocs/<domain>/shared/data/payload.db   # deploy.sh adds this
# MEDIA_DIR=/home/<site-user>/htdocs/<domain>/shared/media                     # deploy.sh adds this
# SEED_ON_EMPTY=true                 # load the launch content when the database is empty

# ── Email: enquiry alerts + admin password resets (any SMTP) ──────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Elite Sports Floor Care <no-reply@elitesportsfloorcare.com.au>"
ENQUIRY_EMAIL_TO=hello@elitesportsfloorcare.com.au

# ── SMS alert to the owner: clicksend | console | none ─────────────
SMS_PROVIDER=clicksend
SMS_TO=+614XXXXXXXX
SMS_FROM=EliteFloor                  # optional alpha sender ID, max 11 chars
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=

# ── Spam protection ────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=      # build-time: set in GitHub (staging env)
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=                        # openssl rand -hex 32
RATE_LIMIT_PER_HOUR=5
