# ── Site ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://elitesportsfloorcare.com.au

# ── Database (MySQL 8 / MariaDB 10.6+ — create it in CloudPanel → Databases) ──
# URL-encode special characters in the password (e.g. @ → %40)
DATABASE_URL=mysql://efc_user:CHANGE_ME@127.0.0.1:3306/efc
RUN_MIGRATIONS=true                 # apply drizzle/ migrations on server start
# MYSQL_PASSWORD=CHANGE_ME          # only for the optional docker-compose route

# ── Email (any SMTP: Resend smtp.resend.com:465, Zoho, M365, client's host) ──
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Elite Sports Floor Care <no-reply@elitesportsfloorcare.com.au>"
ENQUIRY_EMAIL_TO=hello@elitesportsfloorcare.com.au

# ── SMS alert to the owner: clicksend | console | none ─────────────
SMS_PROVIDER=clicksend
SMS_TO=+614XXXXXXXX
SMS_FROM=EliteFloor                 # optional alpha sender ID, max 11 chars
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=

# ── Spam protection ────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=     # build-time: baked into the client bundle
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=                       # long random string: openssl rand -hex 32
RATE_LIMIT_PER_HOUR=5
